# web/ — deployable console (spec 009)
# Server-side only. NOT VITE_-prefixed, so Vite never places these in the client
# bundle (NFR-009-05). Set these in the Vercel project's Environment Variables.

# The shared secret an upload (POST /api/fixture) must carry in x-rewind-token.
# The push helper (tools/push_console.py) sends the same value.
REWIND_CONSOLE_TOKEN=

# Credential for the Vercel Blob store that holds the one current fixture.
# From the Vercel project's Storage tab. If unset, the deploy still serves the
# bundled public/tree.json on GET and POST returns 501.
BLOB_READ_WRITE_TOKEN=

# Optional, client-side (safe to expose). Poll interval in ms; default 2000,
# clamped to <= 2000 to match spec 006.
# VITE_POLL_MS=2000

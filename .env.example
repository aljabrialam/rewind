DAYTONA_API_KEY=dtn_7f9bc5dff2c8927c5a76dd2132843041a3009ed9a404c5c2cc6e7a794d3b39c0
DAYTONA_SNAPSHOT=            # VM-class snapshot name, from the capability map
LLM_API_KEY=
LLM_BASE_URL=                # unset = primary provider
LLM_MODEL=
CRITIC_BASE_URL=             # spec 008 — self-hosted critic endpoint; BOTH this and
CRITIC_MODEL=                #   CRITIC_MODEL must be set to route the critic there (else primary)
CRITIC_API_KEY=              # optional; falls back to LLM_API_KEY
REWIND_ALT_WAIT=             # optional; alternate wait bound, clamped to <= REWIND_CRITIC_WAIT
MAX_BRANCHES=3
MAX_STEPS=50                  # spec 002 — max steps in one branch before it halts
SANDBOX_AUTO_STOP_MINUTES=2
SANDBOX_AUTO_DELETE_MINUTES=10

# --- sandbox capability contract (spec 000) — all optional, sane defaults ---
REWIND_CAPABILITY_MAP=        # override path to capability-map.toml (default: .rewind/)
REWIND_READINESS_WAIT=30      # seconds to wait for a new sandbox to accept a command
REWIND_SLOT_WAIT=20           # seconds to wait for a concurrency slot before failing `capacity`
REWIND_DESTROY_RETRIES=3      # destroy attempts before recording an unconfirmed-destroy leak
REWIND_DESTROY_RETRY_GAP=2    # seconds between destroy attempts
